generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  emailVerified   DateTime?
  name            String?
  username        String?       @unique
  password        String?
  image           String?
  pxviiipd_balance Int          @default(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  accounts        Account[]
  sessions        Session[]
  predictions     Prediction[]
  collectibles    Collectible[]
  transactions    Transaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Match {
  id        String      @id @default(cuid())
  team1     String
  team2     String
  team1Logo String?
  team2Logo String?
  date      DateTime
  venue     String
  status    String      @default("upcoming") // upcoming, live, completed
  result    String?
  createdAt DateTime    @default(now())
  
  subEvents    SubEvent[]
  predictions  Prediction[]
  collectibles Collectible[]
}

model SubEvent {
  id            String   @id @default(cuid())
  matchId       String
  type          String   // top_scorer_a, top_scorer_b, top_wicket, powerplay, sixes, first_wicket, partnership, winner, potm, total_score
  description   String
  options       String   // JSON array of options
  correctAnswer String?
  createdAt     DateTime @default(now())
  
  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  predictions Prediction[]
}

model Prediction {
  id               String   @id @default(cuid())
  userId           String
  matchId          String
  subEventId       String
  selectedOption   String
  creditsAllocated Int      @default(1)
  isCorrect        Boolean?
  points           Int      @default(0)
  createdAt        DateTime @default(now())
  
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  subEvent SubEvent @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  
  @@unique([userId, subEventId])
}

model Collectible {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  rarity        String   // common, rare, epic, legendary
  metadata      String   // JSON with card details
  listedForSale Boolean  @default(false)
  price         Int?
  createdAt     DateTime @default(now())
  
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // earned, spent, received, trade
  amount      Int
  description String
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
